#!/bin/bash

for F in $(git ls-files | grep -E "^public/.*\.(html|css|js|svg)$")
do
	if test "$F" -nt "$F.br" || test "$F" -ot "$F.br"
	then
		echo brotli -f "$F"
		brotli -f "$F"
	fi
done

for M in $(sqlite3 db "select title_id from titles")
do
	pushd public/$M >/dev/null
	for F in $(git ls-files | grep -E "^.*\.(html|css|js|svg)$")
	do
		if test "$F" -nt "$F.br" || test "$F" -ot "$F.br"
		then
			echo brotli -f "$M/$F"
			brotli -f "$F"
		fi
	done
	popd >/dev/null
done
