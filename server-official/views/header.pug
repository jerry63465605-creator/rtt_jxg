header
	a(href="/")
		if SITE_ICON
			img(src="/images/"+SITE_ICON width=48 height=48)
		else
			img(src="/images/rally-the-troops.svg" width=48 height=48)
	nav
		a(href="/about") About
		if user
			if ENABLE_FORUM
				a(href="/forum") Forum
			a(href="/games/library") Games
			a(href="/games/public") Lobby
			if user.waiting_games + user.waiting_chats > 0
				a(href="/games/active") Play (#{user.waiting_games + user.waiting_chats})
			else
				a(href="/games/active") Play
			a(href="/contacts") Friends
			if user.unread > 0
				a(href="/message/inbox") Inbox (#{user.unread})
			else
				a(href="/message/inbox") Inbox
			a(href="/account") ( #{user.name} )
		else
			a(href="/games/library") Games
			a(href="/signup") Signup
			a(href="/login") Login
